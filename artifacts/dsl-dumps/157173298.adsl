:::

:::shape id=card_pref at=top-left width=1120 height=80 offsetX=80 offsetY=152 kind=rect fill=surface borderRadius=12
:::

:::icon id=icn_pref at=top-left width=32 height=32 offsetX=104 offsetY=176 name=users size=28 color=#06B6D4
